# SmartWaste Environment Variables
# Copy this file to .env and fill in your values

# Security
SECRET_KEY=your-secret-key-here-change-in-production

# Environment
ENVIRONMENT=development

# OpenWeatherMap API Key
# Get your free API key at: https://openweathermap.org/api
# Free tier: 1,000 calls/day, 5-day/3-hour forecast
OPENWEATHER_API_KEY=your-openweathermap-api-key-here

# Database (optional - defaults to MLproject/database/smartwaste.db)
# DATABASE_URL=sqlite:///path/to/your/smartwaste.db